# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# Alles ist freiwillig: ohne .env läuft das Tool mit den Standardwerten.

# Port der Weboberfläche (http://localhost:3000)
PORT=3000

# Cardmarket-Provision in Prozent. Damit rechnet das Tool aus, was nach dem Verkauf übrig bleibt.
CARDMARKET_FEE_PERCENT=5

# Verlauf nur für Karten ab diesem Preis (Euro) speichern. Gemerkte Karten werden immer gespeichert.
# Größer = kleinere Datenbank, aber Trends über den eigenen Verlauf nur ab diesem Preis.
HISTORY_MIN_TREND=0.1

# 1 = beim Start nicht automatisch nach Updates suchen
KARTENHAIN_NO_UPDATE=

# Cardmarket-API (nur für "5 günstigste Angebote mit Verkäuferland" nötig).
# Zugang beantragen: Cardmarket > Konto > API-Einstellungen ("Dedicated App").
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=
CARDMARKET_ACCESS_TOKEN=
CARDMARKET_ACCESS_SECRET=
